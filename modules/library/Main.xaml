  <Style x:Key="ThumbnailSlider" TargetType="Slider">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="22" Background="Transparent"><Border Height="3" Background="{DynamicResource Border}" CornerRadius="1" VerticalAlignment="Center" Margin="5,0"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource ScrollPage}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Muted}" CornerRadius="6"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource ScrollPage}"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="Tile">
   <Border x:Name="TileBorder" Tag="{Binding Asset}" Width="{Binding Width}" Margin="6,0,6,10" CornerRadius="2" BorderThickness="2" Background="Transparent" BorderBrush="Transparent" Focusable="True" ToolTip="{Binding Asset.Name}">
    <Grid>
    <StackPanel>
     <Grid Height="{Binding ImageHeight}">
      <Grid Width="86" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Asset.IsDirectory, Converter={StaticResource VisibleWhenTrue}}">
       <Path Data="M 7,8 Q 7,3 12,3 L 31,3 Q 34,3 37,7 L 41,12 L 74,12 Q 79,12 79,17 L 79,52 Q 79,57 74,57 L 12,57 Q 7,57 7,52 Z" Fill="{DynamicResource Accent}" Opacity="0.45"/>
       <Path Data="M 7,23 Q 7,18 12,18 L 76,18 Q 82,18 82,24 L 78,55 Q 77,60 72,60 L 12,60 Q 7,60 7,55 Z" Fill="{DynamicResource Accent}"/>
      </Grid>
      <TextBlock Text="{Binding Asset.TypeLabel}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=TileImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Asset.IsBookmark}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Asset.IsAudio}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Asset.IsDirectory}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Asset.FileIcon}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Asset.FileIcon, Converter={StaticResource VisibleWhenTrue}}"><TextBlock Text="{Binding Asset.FileGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="30" TextAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Asset.TypeLabel}" FontSize="10" TextAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
      <local:ThumbnailImage x:Name="TileImage" DataContext="{Binding Asset}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Asset.IsAudio, Converter={StaticResource VisibleWhenTrue}}"/>
      <Border x:Name="MediaBadge" Panel.ZIndex="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5" Padding="4,0" Height="17" CornerRadius="2" IsHitTestVisible="False" Focusable="False">
       <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Background" Value="#D91E64"/><Style.Triggers><DataTrigger Binding="{Binding Asset.IsGif}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Asset.IsVideo}" Value="True"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#D92B313A"/></DataTrigger></Style.Triggers></Style></Border.Style>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Path x:Name="VideoBadgePlay" Data="M 0,0 L 6,3.5 L 0,7 Z" Fill="White" Width="6" Height="7" Margin="0,0,4,0" VerticalAlignment="Center" Visibility="{Binding Asset.IsVideo, Converter={StaticResource VisibleWhenTrue}}"/>
        <TextBlock x:Name="MediaBadgeText" Foreground="White" FontSize="10" FontWeight="Bold" FontFamily="Microsoft YaHei UI" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="GIF"/><Style.Triggers><DataTrigger Binding="{Binding Asset.IsVideo}" Value="True"><Setter Property="Text" Value="{Binding Asset.TypeLabel}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel>
      </Border>
     </Grid>
     <StackPanel x:Name="ImageLabels" Height="{Binding LabelHeight}" Margin="3,0"><TextBlock Text="{Binding Asset.Name}" Visibility="{Binding ShowName, Converter={StaticResource VisibleWhenTrue}}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Foreground="{DynamicResource Text}" Margin="0,4,0,0"/><TextBlock Text="{Binding Asset.Dimensions}" Visibility="{Binding ShowDetails, Converter={StaticResource VisibleWhenTrue}}" TextAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
     <Grid x:Name="BookmarkLabels" Height="48" Margin="8,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:BookmarkIcon x:Name="SiteIcon" DataContext="{Binding Asset}" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Asset.Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text}" FontSize="13"/><TextBlock Text="{Binding Asset.SiteName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel></Grid>
    </StackPanel>
     <Border x:Name="SelectionMark" HorizontalAlignment="Right" VerticalAlignment="Top" Width="20" Height="20" Margin="5" CornerRadius="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Muted}" BorderThickness="1" IsHitTestVisible="False" Visibility="{Binding Asset.Selecting, Converter={StaticResource VisibleWhenTrue}}"><TextBlock x:Name="SelectionTick" Text="✓" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Asset.Selected, Converter={StaticResource VisibleWhenTrue}}"/></Border>
    </Grid>
   </Border>
   <DataTemplate.Triggers><DataTrigger Binding="{Binding Asset.IsBookmark}" Value="True"><Setter TargetName="ImageLabels" Property="Visibility" Value="Collapsed"/><Setter TargetName="BookmarkLabels" Property="Visibility" Value="Visible"/><Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource Surface}"/></DataTrigger><Trigger SourceName="TileBorder" Property="IsMouseOver" Value="True"><Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource Hover}"/></Trigger><DataTrigger Binding="{Binding Asset.Selected}" Value="True"><Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource AccentSoft}"/></DataTrigger></DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
   <Grid Margin="22,0,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="MORI" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock Text="DESK" Foreground="{DynamicResource Muted}" Margin="12,9,0,0" FontSize="11"/></StackPanel>
    <Grid Grid.Column="1" Margin="14,0,22,0"><TextBox x:Name="Search" Height="35" ToolTip="搜索名称、标签、备注或来源网址  Ctrl+F" AutomationProperties.Name="搜索素材"/><TextBlock Text="搜索名称、标签、网址…" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
