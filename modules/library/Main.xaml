   </Grid>
  </Border>
  <Grid Grid.Row="1" x:Name="Workspace"><Grid.ColumnDefinitions><ColumnDefinition Width="208" MinWidth="160" MaxWidth="480"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="480"/><ColumnDefinition Width="6"/><ColumnDefinition Width="252" MinWidth="240" MaxWidth="520"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
    <DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,14,0,10">
     <Button x:Name="All" Style="{StaticResource Nav}" local:UiIcons.Glyph="&#xE80A;" Content="全部素材" ToolTip="图片、动图、视频和音频；不包含网址和文档"/>
     <Button x:Name="Pictures" Style="{StaticResource Nav}" local:UiIcons.Glyph="&#xEB9F;" Content="图片" ToolTip="全部图片，包括 GIF 等动图与 SVG"/>
     <Button x:Name="Videos" Style="{StaticResource Nav}" local:UiIcons.Glyph="&#xE714;" Content="视频"/>
     <Button x:Name="Audio" Style="{StaticResource Nav}" local:UiIcons.Glyph="&#xE8D6;" Content="音频" ToolTip="双击使用电脑默认播放器打开"/>
     <Border Height="1" Margin="24,4,24,4" Background="{DynamicResource Divider}"/>
     <Button x:Name="Bookmarks" Style="{StaticResource Nav}" local:UiIcons.Glyph="&#xE774;" Content="网址" ToolTip="网址文件夹在页面内管理"/>
