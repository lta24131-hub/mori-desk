<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Nook.FileConversion</AssemblyName>
    <RootNamespace>Nook.FileConversion</RootNamespace>
    <Version>0.1.0</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <ProjectReference Include="$(FileeSourceRoot)\src\Filee.Core\Filee.Core.csproj" />
    <ProjectReference Include="$(FileeSourceRoot)\src\Filee.Engines\Filee.Engines.csproj" />
  </ItemGroup>
  <Target Name="RequireReviewedSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FileeSourceRoot)' == ''" Text="Use build.ps1 with the pinned, verified Filee source." />
  </Target>
</Project>
