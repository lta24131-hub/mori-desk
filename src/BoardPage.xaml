<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="clr-namespace:MoriDesk;assembly=Mori" Background="{DynamicResource Canvas}">
 <Grid.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Background" Value="{DynamicResource Control}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="BorderBrush" Value="{DynamicResource Divider}"/><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Tile" TargetType="ListViewItem"><Setter Property="Margin" Value="5"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="TileBg" Background="{DynamicResource Surface}" Padding="10" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Divider}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TileBg" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="TileBg" Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileBg" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate DataType="{x:Type d:BoardItem}"><Grid ToolTip="{Binding Path}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource Canvas}" CornerRadius="6"><Grid><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><d:BoardImage Stretch="Uniform" Margin="4"/><Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="{DynamicResource Surface}" CornerRadius="3" Padding="5,2" Margin="5"><TextBlock Text="{Binding Kind}" FontSize="10"/></Border></Grid></Border><TextBlock Grid.Row="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/><TextBlock Grid.Row="2" Text="{Binding Storage}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></Grid></DataTemplate>
  <DataTemplate DataType="{x:Type d:BoardBox}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="7" Padding="5"><ItemsControl ItemsSource="{Binding Preview}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="3" ToolTip="{Binding Name}"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><d:BoardImage Stretch="Uniform"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border><TextBlock Grid.Row="2" Text="分类框 · 拖到这里整理" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,10,0,0"/></Grid></DataTemplate>
 </Grid.Resources>
 <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="268" MinWidth="220" MaxWidth="430"/></Grid.ColumnDefinitions>
 <Grid Margin="18,14,12,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="4,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Title" Text="全部素材" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel><TextBox x:Name="Search" Grid.Column="1" Height="34" VerticalAlignment="Center" ToolTip="搜索名称、本地地址、来源网址 · Ctrl+F" AutomationProperties.Name="搜索素材桌面"/></Grid>
  <DockPanel Grid.Row="1" Margin="4,0,0,10"><Button x:Name="Back" Content="← 全部分类框" DockPanel.Dock="Left" Visibility="Collapsed"/><StackPanel Orientation="Horizontal"><Button x:Name="NewBox" Content="＋ 分类框"/><Button x:Name="Add" Content="添加文件…"/><Button x:Name="Refresh" Content="刷新"/></StackPanel></DockPanel>
  <Grid Grid.Row="2"><ListView x:Name="Tiles" BorderThickness="0" Background="Transparent" Padding="0" SelectionMode="Extended" ItemContainerStyle="{StaticResource Tile}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" AutomationProperties.Name="素材桌面"><ListView.ItemsPanel><ItemsPanelTemplate><d:ReferenceTilePanel/></ItemsPanelTemplate></ListView.ItemsPanel></ListView><TextBlock x:Name="Empty" Text="把电脑上的文件拖到这里&#10;只收藏位置，不复制原文件" Foreground="{DynamicResource Muted}" FontSize="18" LineHeight="30" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
  <TextBlock Grid.Row="3" Text="双击打开 · 拖进分类框整理 · 空白处右键新建 · Ctrl+Z 撤销" Foreground="{DynamicResource Muted}" FontSize="11" Margin="4,10,0,0"/>
 </Grid>
 <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Divider}" ResizeBehavior="PreviousAndNext"/>
 <Border Grid.Column="2" Background="{DynamicResource Panel}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
  <TextBlock Text="素材信息" FontWeight="SemiBold" Margin="0,0,0,16"/>
  <TextBlock x:Name="InspectorEmpty" Text="选中素材查看本地地址和来源&#10;&#10;快捷方式只记录位置&#10;图库副本由 Nook 独立保存" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="24"/>
  <StackPanel x:Name="Inspector" Visibility="Collapsed"><Border Background="{DynamicResource Canvas}" CornerRadius="7" Height="145" Margin="0,0,0,14"><Grid><TextBlock x:Name="DetailGlyph" FontFamily="Segoe MDL2 Assets" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><d:BoardImage x:Name="DetailImage" Stretch="Uniform" Margin="6"/></Grid></Border><TextBlock x:Name="DetailName" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailStorage" Foreground="{DynamicResource Muted}" Margin="0,7,0,16" TextWrapping="Wrap"/>
   <StackPanel x:Name="FileDetails"><TextBlock Text="本地地址" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBox x:Name="LocalPath" IsReadOnly="True" TextWrapping="Wrap" Margin="0,7,0,7" BorderThickness="0" Background="Transparent" Padding="0"/><WrapPanel Margin="0,0,0,16"><Button x:Name="Reveal" Content="打开位置" Padding="10,6"/><Button x:Name="CopyPath" Content="复制地址" Padding="10,6"/></WrapPanel><StackPanel x:Name="SourceArea"><TextBlock Text="来源网址" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBox x:Name="Source" IsReadOnly="True" TextWrapping="Wrap" Margin="0,7,0,7" BorderThickness="0" Background="Transparent" Padding="0"/><Button x:Name="OpenSource" Content="打开来源网页 ↗" HorizontalAlignment="Left" Margin="0,0,0,16"/></StackPanel></StackPanel>
   <StackPanel x:Name="SingleActions"><Button x:Name="Open" Content="打开" Margin="0,0,0,8"/><Button x:Name="CopyToLibrary" Content="另存到素材库…" Margin="0,0,0,8"/><Button x:Name="Relink" Content="重新定位原文件…" Margin="0,0,0,8"/></StackPanel><Button x:Name="RenameBox" Content="重命名分类框…" Margin="0,0,0,8"/><Button x:Name="Move" Content="移到分类框…" Margin="0,0,0,8"/><Button x:Name="Remove" Content="移除" Margin="0,0,0,8"/><TextBlock x:Name="Safety" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,4,0,0"/>
   <Button x:Name="EditInfo" Content="编辑名称 / 备注…" Margin="0,12,0,0"/>
  </StackPanel>
 </StackPanel></ScrollViewer></Border>
</Grid>
