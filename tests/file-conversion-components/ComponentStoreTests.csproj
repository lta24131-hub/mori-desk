<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../modules/file-conversion/src/Component*.cs" Link="Production/%(Filename)%(Extension)" />
    <Reference Include="Filee.Core"><HintPath>$(WorkerDirectory)/Filee.Core.dll</HintPath></Reference>
    <Reference Include="Filee.Engines"><HintPath>$(WorkerDirectory)/Filee.Engines.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>$(WorkerDirectory)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
  </ItemGroup>
</Project>
