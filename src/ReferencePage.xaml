<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:desk="clr-namespace:MoriDesk;assembly=Mori" Background="{DynamicResource Canvas}" Margin="22,16,14,4">
 <Grid.Resources>
  <Geometry x:Key="FolderShape">M 2,7 L 2,23 Q 2,25 4,25 L 29,25 Q 31,25 31,23 L 31,9 Q 31,7 29,7 L 15,7 L 12,3 L 4,3 Q 2,3 2,5 Z</Geometry>
  <Style x:Key="Card" TargetType="ListViewItem">
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="Surface" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="9" Padding="8"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FolderCard" TargetType="ListBoxItem">
   <Setter Property="Width" Value="196"/><Setter Property="Height" Value="78"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="{DynamicResource Surface}" CornerRadius="8" Padding="13,10" BorderBrush="{DynamicResource Divider}" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本地收藏" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="拖进来就收藏位置 · 文件夹只保存入口，不导入里面的文件" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,14,0" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="1" VerticalAlignment="Center"><TextBox x:Name="Search" Height="35" AutomationProperties.Name="搜索本地收藏"/><TextBlock x:Name="SearchHint" Text="搜索名称或原位置 · Ctrl+F" Foreground="{DynamicResource Muted}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Grid>
 <WrapPanel Grid.Row="1" Margin="0,0,0,14"><Button x:Name="AddFiles" Content="＋ 收藏文件" Background="{DynamicResource AccentSoft}"/><Button x:Name="AddDirectory" Content="收藏电脑文件夹" ToolTip="只收藏文件夹入口，不扫描或复制里面的文件"/><Button x:Name="NewFolder" Content="新建分类"/><Button x:Name="Refresh" Content="刷新" ToolTip="刷新原文件状态 · F5"/></WrapPanel>
 <StackPanel Grid.Row="2" Margin="0,0,0,8"><DockPanel Margin="0,0,0,9"><Button x:Name="ManageFolder" Content="管理分类…" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="8,4" Margin="0,0,8,0" Background="Transparent"/><TextBlock Text="文件夹分类" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ListBox x:Name="Folders" MaxHeight="174" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource FolderCard}" AutomationProperties.Name="本地收藏分类"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{StaticResource FolderShape}" Width="31" Height="25" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" VerticalAlignment="Center" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
 <Grid Grid.Row="3" Margin="0,0,0,6" MinHeight="36"><TextBlock x:Name="Section" VerticalAlignment="Center" FontWeight="SemiBold"/><Border x:Name="Actions" Background="{DynamicResource Canvas}" Visibility="Collapsed"><WrapPanel VerticalAlignment="Center"><TextBlock x:Name="SelectedCount" Margin="0,0,12,0" VerticalAlignment="Center"/><Button x:Name="Open" Content="打开" Padding="10,5"/><Button x:Name="Reveal" Content="原文件位置" Padding="10,5"/><Button x:Name="Move" Content="移到分类…" Padding="10,5"/><Button x:Name="Remove" Content="移除收藏" ToolTip="只移除快捷收藏，原文件不动 · Delete" Padding="10,5"/><Button x:Name="Clear" Content="取消选择" Padding="10,5" Background="Transparent"/></WrapPanel></Border></Grid>
 <Grid Grid.Row="4"><ListView x:Name="Files" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Extended" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource Card}" AutomationProperties.Name="本地收藏卡片"><ListView.ItemsPanel><ItemsPanelTemplate><desk:ReferenceTilePanel/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Path}"><Grid.RowDefinitions><RowDefinition Height="128"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{DynamicResource Canvas}" CornerRadius="5"><Grid><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Preview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="{StaticResource FolderShape}" Width="48" Height="40" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Directory}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="42" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Directory}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,9,0,0"/></StackPanel><desk:ReferenceThumbnail x:Name="Preview" Stretch="Uniform" Margin="4"/><Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="{DynamicResource Surface}" CornerRadius="3" Margin="5" Padding="5,2"><TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Text}" FontSize="10"/></Border></Grid></Border><TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="1,9,1,0"/><TextBlock Grid.Row="2" Text="{Binding Location}" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="1,4,1,0"/><TextBlock Grid.Row="3" FontSize="10" Margin="1,4,1,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="原位置 · 快捷收藏"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="失效 / 暂不可访问"><Setter Property="Text" Value="原文件失效 · 右键重新定位"/><Setter Property="Foreground" Value="#DC966B"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="Empty" Text="拖入文件或电脑文件夹&#10;在这里显示大卡片，不复制原件" FontSize="18" TextAlignment="Center" LineHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/></Grid>
 <TextBlock x:Name="Info" Grid.Row="5" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,10,0,4" TextTrimming="CharacterEllipsis" Text="双击打开 · Ctrl / Shift 多选 · 拖到上方分类 · 移除收藏不删除原件"/>
</Grid>
